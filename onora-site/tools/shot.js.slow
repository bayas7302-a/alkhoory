const { chromium } = require('playwright');
const { execFileSync } = require('child_process');
(async () => {
  const w = +process.argv[2];
  const r = JSON.parse(execFileSync('/home/user/alkhoory/onora-site/tools/mcp.py', ['elementor-create-preview-link', JSON.stringify({ post_id: 28 })]).toString());
  const b = await chromium.launch(); const p = await b.newPage({ viewport: { width: w, height: 900 } });
  await p.goto(r.preview_url || r.url, { waitUntil: 'networkidle', timeout: 120000 });
  const H = await p.evaluate(() => document.body.scrollHeight);
  for (let y = 0; y < H; y += 400) { await p.evaluate(y => window.scrollTo(0, y), y); await p.waitForTimeout(200); }
  await p.evaluate(() => window.scrollTo(0, 0)); await p.waitForTimeout(2500);
  await p.screenshot({ path: `products-${w}.png`, fullPage: true });
  console.log(JSON.stringify(await p.evaluate(() => ({ sw: document.documentElement.scrollWidth, h: document.body.scrollHeight, broken: [...document.images].filter(i => !i.naturalWidth).length }))));
  await b.close();
})();
