/* ===================== SOHARON CHECKOUT ===================== */
.soharon-checkout { font-family: 'Jost', sans-serif; color: #222; max-width: 1300px; margin: 0 auto; }
.soharon-checkout * { box-sizing: border-box; }

/* Coupon bar */
.soharon-checkout-coupon {
    width: 550px; max-width: 100%; margin: 0 auto 40px; padding: 16px 20px;
    background: #e2e2e2; border-radius: 5px; text-align: center;
}
.soharon-checkout-coupon p { margin: 0; font-weight: 300; font-size: 16px; color: #6d6e71; }
.soharon-checkout-coupon .soharon-showcoupon { font-weight: 500; color: #6d6e71; text-decoration: none; }
.soharon-checkout-coupon form.checkout_coupon { margin-top: 14px; display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; }
.soharon-checkout-coupon .input-text { width: 300px; max-width: 100%; height: 46px; border: 1px solid #ccc; padding: 0 12px; }
.soharon-checkout-coupon .button { height: 46px; padding: 0 22px; background: #222; color: #fff; border: none; text-transform: uppercase; font-weight: 300; cursor: pointer; }

/* ---- THE KEY FIX: make the real Woo form a 2-column grid ---- */
.soharon-checkout form.checkout.woocommerce-checkout {
    display: grid;
    grid-template-columns: 1fr 500px;
    gap: 70px;
    align-items: start;
}
/* left column holds billing; right column holds order review + payment.
   The shortcode outputs #customer_details, then #order_review_heading,
   #order_review and #payment as siblings — place them explicitly. */
.soharon-checkout #customer_details { grid-column: 1; grid-row: 1 / span 3; }
.soharon-checkout #order_review_heading { grid-column: 2; grid-row: 1; margin: 0; }
.soharon-checkout #order_review { grid-column: 2; grid-row: 2; }
.soharon-checkout #payment { grid-column: 2; grid-row: 3; }

@media (max-width: 1024px) {
    .soharon-checkout form.checkout.woocommerce-checkout { grid-template-columns: 1fr; gap: 30px; }
    .soharon-checkout #customer_details,
    .soharon-checkout #order_review_heading,
    .soharon-checkout #order_review,
    .soharon-checkout #payment { grid-column: 1; grid-row: auto; }
}

/* Billing columns: stack the col-1/col-2 into one flow, full width */
.soharon-checkout .col2-set,
.soharon-checkout .col2-set .col-1,
.soharon-checkout .col2-set .col-2 { width: 100%; float: none; padding: 0; }

/* Headings */
.soharon-checkout h3 {
    font-weight: 300; font-size: 24px; letter-spacing: .02em; text-transform: uppercase;
    color: #222; margin: 0 0 24px;
}

/* Fields: stacked, full width */
.soharon-checkout .form-row { display: block; width: 100%; margin: 0 0 20px; padding: 0; float: none; }
.soharon-checkout .form-row label { display: block; font-weight: 300; font-size: 16px; color: #222; margin-bottom: 8px; }
.soharon-checkout .form-row label .required { color: #222; }
.soharon-checkout .form-row .optional { display: none; }

.soharon-checkout .input-text,
.soharon-checkout textarea,
.soharon-checkout select,
.soharon-checkout .select2-container .select2-selection--single {
    width: 100% !important; height: 56px;
    border: 1px solid #d9d9d9 !important; border-radius: 0;
    padding: 0 16px; background: #fff; box-shadow: none; outline: none;
    font-family: 'Jost', sans-serif; font-weight: 300; font-size: 16px; color: #222;
}
.soharon-checkout textarea { height: 120px; padding: 14px 16px; resize: vertical; }
.soharon-checkout .input-text::placeholder,
.soharon-checkout textarea::placeholder { color: #b3b3b3; }

/* select2 country to match */
.soharon-checkout .select2-container--default .select2-selection--single { display: flex; align-items: center; }
.soharon-checkout .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 54px; padding: 0; color: #222; }
.soharon-checkout .select2-container--default .select2-selection--single .select2-selection__arrow { height: 54px; }

/* ship-to + notes */
.soharon-checkout #ship-to-different-address { margin: 6px 0 20px; font-size: 16px; font-weight: 300; }
.soharon-checkout #ship-to-different-address label { display: inline-flex; align-items: center; gap: 10px; }
.soharon-checkout .woocommerce-additional-fields h3 { display: none; }

/* ---- Order summary box (right) ---- */
.soharon-checkout #order_review_heading { font-weight: 300; font-size: 22px; text-transform: uppercase; }
.soharon-checkout #order_review { border: 1px solid #e2e2e2; padding: 30px; }
.soharon-checkout .shop_table { width: 100%; border-collapse: collapse; }
.soharon-checkout .shop_table th,
.soharon-checkout .shop_table td { padding: 16px 0; border: 0; font-weight: 300; font-size: 16px; color: #222; text-align: left; }
.soharon-checkout .shop_table thead th { color: #6d6e71; padding-bottom: 10px; }
.soharon-checkout .shop_table thead th.product-total { text-align: right; }
.soharon-checkout .shop_table .cart_item td { border-bottom: 1px solid #e2e2e2; vertical-align: middle; }
.soharon-checkout .checkout-product-thumb { width: 60px; height: 60px; object-fit: cover; }
.soharon-checkout .product-total { text-align: right; white-space: nowrap; }
.soharon-checkout tfoot th, .soharon-checkout tfoot td { border-bottom: 1px solid #e2e2e2; color: #6d6e71; }
.soharon-checkout tfoot td { text-align: right; color: #222; }
.soharon-checkout tfoot .order-total th, .soharon-checkout tfoot .order-total td { color: #000; font-weight: 400; border-bottom: 0; }

/* payment */
.soharon-checkout #payment { background: transparent; border: 0; padding: 0; margin-top: 24px; }
.soharon-checkout #payment ul.payment_methods { border: 0; padding: 0; margin: 0 0 20px; list-style: none; display: flex; flex-direction: column; gap: 12px; }
.soharon-checkout #payment ul.payment_methods li { border: 1px solid #d9d9d9; border-radius: 6px; padding: 16px 18px; display: flex; align-items: center; gap: 12px; }
.soharon-checkout #payment ul.payment_methods li label { margin: 0; font-weight: 400; font-size: 16px; }
.soharon-checkout #payment .payment_box { background: transparent; margin: 10px 0 0; padding: 0; font-size: 14px; color: #6d6e71; }
.soharon-checkout #payment .payment_box::before { display: none; }
.soharon-checkout .woocommerce-privacy-policy-text p { font-weight: 300; font-size: 14px; color: #6d6e71; line-height: 1.6; }

/* place order */
.soharon-checkout #place_order {
    display: block; width: 100%; height: 60px; line-height: 60px;
    background: #111 !important; color: #fff !important; border: 0; border-radius: 2px; padding: 0;
    font-weight: 300; font-size: 20px; letter-spacing: .06em; text-transform: uppercase; text-align: center; cursor: pointer;
}
.soharon-checkout #place_order:hover { background: #333 !important; }

.soharon-checkout .woocommerce-info { background: #f7f7f7; border: 0; padding: 14px 16px; font-size: 14px; color: #6d6e71; }

@media (max-width: 767px) {
    
   /* Matches the real markup: <p class="form-row..."><input class="input-text"> */
    .form-row input.input-text,
    .form-row select,
    .form-row textarea {
        border-radius: 9px !important;
    }

    /* Round the visible Select2 country box (the real select is hidden) */
    .select2-container--default .select2-selection--single {
        border-radius: 9px !important;
    }

    .form-row textarea {
        margin-bottom: 30px !important;
    }

    #order_review_heading,
    .woocommerce-billing-fields h3 {
        font-size: 15px !important;
    }
    

    .soharon-checkout,
    .soharon-checkout * {
        box-sizing: border-box !important;
    }
    .soharon-checkout {
        overflow-x: hidden !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    /* Coupon bar */
    .soharon-checkout-coupon {
        width: 340px !important;
        max-width: 100% !important;
        border-radius: 9px !important;
        background-color: #e2e2e2 !important;
        padding: 12px 16px !important;
    }
    .soharon-checkout-coupon p {
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 12px !important;
        color: #6d6e71 !important;
    }
    .soharon-checkout-coupon .soharon-showcoupon {
        font-family: 'Jost', sans-serif !important;
        font-weight: 500 !important;
        font-size: 12px !important;
        color: #6d6e71 !important;
    }
    .soharon-checkout-coupon .input-text {
        width: 100% !important;
        height: 40px !important;
        font-size: 12px !important;
    }
    .soharon-checkout-coupon .button {
        height: 40px !important;
        font-size: 12px !important;
        border-radius: 9px !important;
    }

    /* Force single column layout */
    .soharon-checkout form.checkout.woocommerce-checkout {
        display: block !important;
        grid-template-columns: 1fr !important;
        gap: 20px !important;
    }
    .soharon-checkout #customer_details,
    .soharon-checkout #order_review_heading,
    .soharon-checkout #order_review,
    .soharon-checkout #payment {
        grid-column: 1 !important;
        grid-row: auto !important;
        width: 100% !important;
    }

    /* Headings */
    .soharon-checkout h3 {
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 14px !important;
        color: #222222 !important;
        margin: 0 0 14px !important;
    }

    /* Billing fields */
    .soharon-checkout .form-row {
        margin: 0 0 14px !important;
    }
    .soharon-checkout .form-row label {
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 12px !important;
        color: #222222 !important;
        margin-bottom: 6px !important;
    }
    .soharon-checkout .input-text,
    .soharon-checkout textarea,
    .soharon-checkout select,
    .soharon-checkout .select2-container .select2-selection--single {
        height: 40px !important;
        border-radius: 9px !important;
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 12px !important;
        color: #6d6e71 !important;
        padding: 0 12px !important;
    }
    .soharon-checkout textarea {
        height: 100px !important;
        padding: 12px !important;
    }
    .soharon-checkout .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 40px !important;
        font-size: 12px !important;
    }
    .soharon-checkout .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 40px !important;
    }

    /* Ship to different address */
    .soharon-checkout #ship-to-different-address {
        margin: 14px 0 !important;
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 12px !important;
        color: #6d6e71 !important;
    }

    /* Order notes textarea */
    .soharon-checkout .woocommerce-additional-fields textarea {
        height: 100px !important;
        border-radius: 9px !important;
    }

    /* Order review box (right column, now stacked) */
    .soharon-checkout #order_review {
        border: 0.25px solid #6b6a6b !important;
        border-radius: 9px !important;
        padding: 16px !important;
    }
    .soharon-checkout #order_review_heading {
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 14px !important;
        color: #222222 !important;
    }
    .soharon-checkout .shop_table th,
    .soharon-checkout .shop_table td {
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 12px !important;
        color: #222222 !important;
        padding: 10px 0 !important;
    }
    .soharon-checkout .shop_table thead th {
        color: #6d6e71 !important;
    }
    .soharon-checkout .checkout-product-thumb {
        width: 45px !important;
        height: 45px !important;
    }

    /* Payment methods */
    .soharon-checkout #payment ul.payment_methods li {
        border-radius: 9px !important;
        padding: 12px 14px !important;
    }
    .soharon-checkout #payment ul.payment_methods li label {
        font-family: 'Jost', sans-serif !important;
        font-weight: 400 !important;
        font-size: 12px !important;
    }
    .soharon-checkout #payment .payment_box {
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 12px !important;
        color: #6d6e71 !important;
    }
    .soharon-checkout .woocommerce-privacy-policy-text p {
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 12px !important;
        color: #6d6e71 !important;
    }

    /* Place order button */
    .soharon-checkout #place_order {
        height: 40px !important;
        line-height: 40px !important;
        border-radius: 9px !important;
        font-family: 'Jost', sans-serif !important;
        font-weight: 300 !important;
        font-size: 14px !important;
    }
}/* End custom CSS */
