        var href = $card.find('a.elementor-button-link, a[href*=\"add-to-cart=\"]').first().attr('href');\r\n        if (!href) return null;\r\n        var match = href.match(\/add-to-cart=(\\d+)\/);\r\n        return match ? match[1] : null;\r\n    }\r\n\r\n    function attachHoverImages() {\r\n        var idMap = {};\r\n\r\n        $('.elementor-loop-container').find('.elementor-widget-image').each(function () {\r\n            var $imgWidget = $(this);\r\n            if ($imgWidget.data('hoverAttached')) return;\r\n\r\n            \/\/ Card wrapper is the swiper-slide, not e-loop-item\r\n            var $card = $imgWidget.closest('.swiper-slide');\r\n            if (!$card.length) return;\r\n\r\n            var productId = extractProductId($card);\r\n            if (!productId) return;\r\n\r\n            idMap[productId] = idMap[productId] || [];\r\n            idMap[productId].push($imgWidget);\r\n            $imgWidget.data('hoverAttached', true);\r\n        });\r\n\r\n        var ids = Object.keys(idMap);\r\n        if (!ids.length) {\r\n            console.log('soharon hover: no product IDs found');\r\n            return;\r\n        }\r\n\r\n        console.log('soharon hover: found IDs', ids);\r\n\r\n        $.ajax({\r\n            url: soharonHover.ajaxUrl,\r\n            type: 'POST',\r\n            data: {\r\n                action: 'get_hover_images',\r\n                nonce: soharonHover.nonce,\r\n                product_ids: ids\r\n            },\r\n            success: function (response) {\r\n                console.log('soharon hover: ajax response', response);\r\n                if (!response.success) return;\r\n                var images = response.data;\r\n\r\n                ids.forEach(function (id) {\r\n                    if (!images[id]) return;\r\n                    idMap[id].forEach(function ($imgWidget) {\r\n                        var $container = $imgWidget.find('.elementor-widget-container').length\r\n                            ? $imgWidget.find('.elementor-widget-container')\r\n                            : $imgWidget;\r\n                        if ($container.find('.soharon-hover-img').length) return;\r\n\r\n                        var $hoverImg = $('<img>', {\r\n                            src: images[id],\r\n                            class: 'soharon-hover-img',\r\n                            alt: ''\r\n                        });\r\n                        $container.css('position', 'relative').append($hoverImg);\r\n                    });\r\n                });\r\n            },\r\n            error: function (xhr) {\r\n                console.log('soharon hover: ajax error', xhr.responseText);\r\n            }\r\n        });\r\n    }\r\n\r\n    attachHoverImages();\r\n\r\n    $(document).on('click', '.shop-cat-nav .cat-link', function () {\r\n        setTimeout(attachHoverImages, 600);\r\n    });\r\n});\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-267603d zoom-img elementor-widget elementor-widget-image\" data-id=\"267603d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https:\/\/soharon.co.uk\/dev-101\/product\/fanora-rose-gold-plated-necklace\/\">\n\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1500\" height=\"1500\" src=\"https:\/\/soharon.co.uk\/dev-101\/wp-content\/uploads\/2026\/08\/1.webp\" class=\"attachment-full size-full wp-image-2816\" alt=\"\" srcset=\"https:\/\/soharon.co.uk\/dev-101\/wp-content\/uploads\/2026\/08\/1.webp 1500w, https:\/\/soharon.co.uk\/dev-101\/wp-content\/uploads\/2026\/08\/1-300x300.webp 300w, https:\/\/soharon.co.uk\/dev-101\/wp-content\/uploads\/2026\/08\/1-1024x1024.webp 1024w, https:\/\/soharon.co.uk\/dev-101\/wp-content\/uploads\/2026\/08\/1-150x150.webp 150w, https:\/\/soharon.co.uk\/dev-101\/wp-content\/uploads\/2026\/08\/1-768x768.webp 768w, https:\/\/soharon.co.uk\/dev-101\/wp-content\/uploads\/2026\/08\/