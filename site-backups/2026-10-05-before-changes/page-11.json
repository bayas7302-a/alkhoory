/* Start custom CSS for html, class: .elementor-element-00b14be */.elementor-11 .elementor-element.elementor-element-00b14be .shop-cat-nav {
  display: flex;
  justify-content: center;
  gap: 60px;
}

.elementor-11 .elementor-element.elementor-element-00b14be .shop-cat-nav .cat-link {
  font-family: 'Jost', sans-serif;
  font-weight: 300;
  font-size: 18px;
  color: #222222;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 1px;
  position: relative;
  display: inline-block;
  padding-bottom: 4px;
}

.elementor-11 .elementor-element.elementor-element-00b14be .shop-cat-nav .cat-link::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 50%;
  right: 50%;
  height: 2px;
  background-color: #222222;
  transition: left 0.3s ease, right 0.3s ease;
}

.elementor-11 .elementor-element.elementor-element-00b14be .shop-cat-nav .cat-link:hover::after,
.elementor-11 .elementor-element.elementor-element-00b14be .shop-cat-nav .cat-link.active::after {
  left: 0;
  right: 0;
}

.elementor-11 .elementor-element.elementor-element-00b14be .shop-cat-nav .cat-link:hover,
.elementor-11 .elementor-element.elementor-element-00b14be .shop-cat-nav .cat-link.active {
  color: #222222;
}

@media (max-width: 768px) {
