sPerView: 2, spaceBetween: 30, slidesPerGroup: 2 },\\n        1025: { slidesPerView: 4, spaceBetween: 30, slidesPerGroup: 4 }\\n    };\\n\\n    function reinitSwiper($carousel) {\\n        if (typeof Swiper === 'undefined') return;\\n        var el = $carousel.get(0);\\n        if (el.swiper) { try { el.swiper.destroy(true, true); } catch (e) {} }\\n\\n        var $widget = $carousel.closest('.elementor-widget-loop-carousel');\\n        var pagEl   = $widget.find('.swiper-pagination').get(0);\\n        if (pagEl) {\\n            pagEl.classList.remove('swiper-pagination-lock');\\n            pagEl.innerHTML = '';\\n        }\\n\\n        var sw = new Swiper(el, {\\n            loop: true,\\n            speed: 500,\\n            watchOverflow: true,\\n            observer: true,\\n            observeParents: true,\\n            slidesPerView: 2,\\n            spaceBetween: 10,\\n            slidesPerGroup: 2,\\n            pagination: pagEl ? { el: pagEl, clickable: true } : false,\\n            breakpoints: SW_BREAKPOINTS\\n        });\\n\\n        setTimeout(function () { try { sw.update(); } catch (e) {} }, 50);\\n    }\\n\\n    function normalizeToWrapper(itemsHtml) {\\n        var $tmp = $('<div>').html(itemsHtml);\\n        $tmp.children('.swiper-slide-duplicate').remove();\\n        if (MAX_SLIDES > 0) { $tmp.children().slice(MAX_SLIDES).remove(); }\\n\\n        $tmp.children().each(function () {\\n            this.className = this.className\\n                .replace(\\\/swiper-slide-(active|next|prev|duplicate[\\\\w-]*)\\\/g, '')\\n                .replace(\\\/\\\\s+\\\/g, ' ')\\n                .trim();\\n            if (!$(this).hasClass('swiper-slide')) { $(this).addClass('swiper-slide'); }\\n            this.removeAttribute('style');\\n            this.removeAttribute('aria-hidden');\\n            this.removeAttribute('inert');\\n        });\\n\\n        return '<div class=\\\"swiper-wrapper\\\">' + $tmp.html() + '<\\\/div>';\\n    }\\n\\n    function getOriginalItemsHtml($carousel) {\\n        var html = '';\\n        $carousel.find('.swiper-slide').not('.swiper-slide-duplicate').each(function () {\\n            html += this.outerHTML;\\n        });\\n        return html;\\n    }\\n\\n    function extractFirstStyle(html) {\\n        var m = html && html.match(\\\/<style[\\\\s\\\\S]*?<\\\\\\\/style>\\\/i);\\n        return m ? m[0] : '';\\n    }\\n\\n    function rebuild($carousel, itemsHtml, prefixHtml) {\\n        $carousel\\n            .html((prefixHtml || '') + normalizeToWrapper(itemsHtml))\\n            .removeClass('soharon-filtered-grid')\\n            .css('opacity', '1');\\n        reinitSwiper($carousel);\\n    }\\n\\n    $(document).on('click', '.shop-cat-nav .cat-link', function (e) {\\n        e.preventDefault();\\n\\n        var $link = $(this);\\n        var $nav  = $link.closest('.shop-cat-nav');\\n\\n        var $carousel = $();\\n        $link.parents().each(function () {\\n            var found = $(this).find('.elementor-loop-container').first();\\n            if (found.length) { $carousel = found; return false; }\\n        });\\n        if (!$carousel.length) return;\\n\\n        if (!$carousel.data('originalItems')) {\\n            $carousel.data('originalItems', getOriginalItemsHtml($carousel));\\n            var styleHtml = '';\\n            $carousel.closest('.elementor-widget-loop-carousel')\\n                     .find('style').each(function () { styleHtml += this.outerHTML; });\\n            $carousel.data('cardStyle', styleHtml);\\n        }\\n\\n        if ($link.hasClass('active')) {\\n            $link.removeClass('active');\\n            rebuild($carousel, $carousel.data('originalItems'), $carousel.data('cardStyle'));\\n            return;\\n        }\\n\\n        $nav.find('.cat-link').removeClass('active');\\n        $link.addClass('active');\\n\\n        var cat = $link.data('cat');\\n\\n        $.ajax({\\n            url: soharonFilter.ajaxUrl,\\n            type: 'POST',\\n   