.soharon-cart__head,
.soharon-cart__row {
    grid-template-columns: 40px 90px 1fr 120px 170px; /* last col 120px -> 170px */
}

/* keep the whole price on one line */
.soharon-cart__row .col-price {
    white-space: nowrap;
    
}

.soharon-cart__row{
    padding: 0px!important;
}

/* Coupon bar */
.soharon-coupon-bar { background: #eee; border-radius: 6px; padding: 22px; text-align: center; margin-bottom: 30px;
max-width: 550px;
    margin: 0 auto 30px;
}
.soharon-coupon-bar p { margin: 0; font-weight: 300; color: #6D6E71; }
.soharon-coupon-bar .soharon-showcoupon { color: #222; font-weight: 400; text-decoration: none; }
.soharon-coupon-form { margin-top: 16px; display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap; }
.soharon-coupon-input { width: 320px; max-width: 100%; height: 48px; border: 1px solid #ccc; padding: 0 12px; font-family: 'Jost', sans-serif; font-weight: 300; font-size: 15px; }
.soharon-coupon-apply { height: 48px; padding: 0 24px; background: #222; color: #fff; border: none; font-family: 'Jost', sans-serif; font-weight: 300; text-transform: uppercase; cursor: pointer; }
.soharon-coupon-apply:hover { background: #474747; }
.soharon-coupon-msg { width: 100%; font-size: 14px; color: #6D6E71; }

/* Layout: items left, summary right */
.soharon-cart__layout { display: grid; grid-template-columns: 1fr 360px; gap: 60px; align-items: start; }

/* Items table */
.soharon-cart__head,
.soharon-cart__row {
    display: grid;
    grid-template-columns: 40px 90px 1fr 120px 120px;
    align-items: center;
    gap: 16px;
}
.soharon-cart__head { padding: 0 0 14px; border-bottom: 1px solid #e5e5e5; }
.soharon-cart__head span { font-weight: 300; letter-spacing: .04em; color: #222; }
.soharon-cart__head .col-qty,
.soharon-cart__row .col-qty { text-align: center; }
.soharon-cart__head .col-price,
.soharon-cart__row .col-price { text-align: right; }

.soharon-cart__row { padding: 26px 0; border-bottom: 1px solid #e5e5e5; }
.soharon-cart__row img { width: 100%; height: 155px; object-fit: cover; display: block; }
.soharon-cart__row .col-name a { color: #222; text-decoration: none; font-weight: 300; text-transform: uppercase; letter-spacing: .03em; }

.soharon-remove { background: none; border: none; font-size: 22px; line-height: 1; color: #777; cursor: pointer; padding: 0; }
.soharon-remove:hover { color: #000; }

/* Price */
.col-price del { color: #b0b0b0; font-weight: 300; margin-right: 8px; }
.col-price del .woocommerce-Price-amount { color: #b0b0b0; }
.col-price ins { text-decoration: none; font-weight: 400; color: #000; }

/* Qty stepper */
.soharon-qty { display: inline-flex; align-items: center; gap: 12px; }
.soharon-qty .sq-btn { background: none; border: none; font-size: 18px; line-height: 1; color: #6D6E71; cursor: pointer; padding: 0; width: 20px; }
.soharon-qty .sq-val { min-width: 16px; text-align: center; font-weight: 400; }

/* Summary */
.soharon-cart__summary { border-left: 0; }
.soharon-summary__title { font-weight: 300; letter-spacing: .04em; margin: 0 0 10px; font-size: 18px; }
.soharon-summary__row { display: flex; justify-content: space-between; align-items: center; padding: 22px 0; border-bottom: 1px solid #e5e5e5; font-weight: 300; color: #6D6E71; }
.soharon-summary__row span:last-child { color: #222; }
.soharon-summary__total span { font-weight: 400; color: #000; }
.soharon-freeship { text-align: center; font-weight: 300; font-size: 14px; color: #222; padding: 16px 0; margin: 0; }
.soharon-freeship--done { color: #1a7f37; }

.soharon-checkout-btn { display: block; width: 100%; background: #222; color: #fff; text-align: center; height: 56px; line-height: 56px; border-radius: 4px; text-decoration: none; font-weight: 300; letter-spacing: .08em; }
.soharon-checkout-btn:hover { background: #393939; color: #FFFFFF;}

.soharon-cart__empty { text-align: center; padding: 60px 0; font-weight: 300; }

/* Responsive */
@media (max-width: 900px) {
    .soharon-cart__layout { grid-template-columns: 1fr; gap: 40px; }
    
    .soharon-cart__row { grid-template-columns: 40px 70px 1fr; grid-auto-rows: auto; row-gap: 10px; }
    .soharon-cart__row .col-qty { grid-column: 2 / 4; text-align: left; }
    .soharon-cart__row .col-price { grid-column: 2 / 4; text-align: left; }
    .soharon-cart__row img { width: 70px; height: 70px; }
}

