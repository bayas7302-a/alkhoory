/* Start custom CSS for loop-carousel, class: .elementor-element-3812a24 *//* After AJAX filter, render products as a 4-up grid instead of the broken carousel */
.elementor-loop-container.soharon-filtered-grid {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 30px !important;
    transform: none !important;      /* kill Swiper's translate3d */
    overflow: hidden !important;
}

/* If the returned markup still keeps a .swiper-wrapper, let the grid see the items */
.elementor-loop-container.soharon-filtered-grid .swiper-wrapper {
    display: contents !important;
    transform: none !important;
}

/* Make each product fill exactly one grid cell */
.elementor-loop-container.soharon-filtered-grid .e-loop-item,
.elementor-loop-container.soharon-filtered-grid .swiper-slide {
    width: 100% !important;
    margin: 0 !important;
    flex: none !important;
}

/* Match the carousel's original responsive counts */
@media (max-width: 1024px) {
    .elementor-loop-container.soharon-filtered-grid { grid-template-columns: repeat(2, 1fr) !important; }
}
@media (max-width: 767px) {
    .elementor-loop-container.soharon-filtered-grid { grid-template-columns: 1fr !important; }
}

/* Optional: hide the carousel dots once it's a grid */
.elementor-widget-loop-carousel:has(.soharon-filtered-grid) .swiper-pagination {
    display: none !important;
}

.swiper-pagination-bullet {
    background: #222222; /* current/default dot color — adjust to match what you have now */
    opacity: 1;
}

.swiper-pagination-bullet-active {
    background: #6d6e71 !important;
    opacity: 1;
}

@media screen and (max-width: 480px) {
  .elementor-11 .elementor-element.elementor-element-3812a24 .swiper-pagination-bullet {
        width: 7px!important;
        height: 7px!important;
    }
}/* End custom CSS */
