/* Main Form */
.custom-contact-form{
    width:585px;
   
}

/* Gap Between Sections */
.custom-contact-form .form-group{
    margin-bottom:30px;
}

/* Labels */
/* Labels */
.custom-contact-form label {
    display: block;
    font-family: "Jost", Sans-serif;
    font-size: 16px;
    font-weight: 300;
    color: #000000;
    line-height: 1;
    margin-bottom: 8px; /* ← ADD THIS */
}

/* Input & Textarea */
.custom-contact-form input[type="text"],
.custom-contact-form input[type="email"],
.custom-contact-form textarea {
    width: 585px;
    height: 65px;
    border: 0.5px solid #6d6e71;
    border-radius: 5px;
    background: transparent;
    font-family: "Jost", Sans-serif;
    font-size: 16px;
    font-weight: 300;
    color: #000000;
    box-sizing: border-box;
    outline: none;
    box-shadow: none;
    margin: 0; /* ← already present, keep this */
    margin-top: 0 !important; /* ← ADD THIS to override any theme defaults */
}
/* Name & Email Fields */
.custom-contact-form input[type="text"],
.custom-contact-form input[type="email"]{
    height:65px !important;
    min-height:65px;
    padding:0 20px;
    line-height:65px;
}

/* Message Field */
.custom-contact-form textarea{
    height:220px;
    padding:20px;
    resize:none;
}

/* Placeholder */
.custom-contact-form ::placeholder{
    color:#9a9a9a;
    font-family:"Jost", Sans-serif;
    font-size:16px;
    font-weight:300;
}

/* Submit Button */
.custom-contact-form .submit-btn{
    margin-top:-4px;
    margin-bottom:-40px;
}

.custom-contact-form input[type="submit"]{
    width:585px;
    height:65px;
    border:none;
    border-radius:5px;
    background:#222222;
    font-family:"Jost", Sans-serif;
    font-size:22px;
    font-weight:300;
    color:#ffffff;
    cursor:pointer;
    transition:none;
    padding:0;
}

/* No Hover Animation */
.custom-contact-form input[type="submit"]:hover{
    background:#222222;
    color:#ffffff;
}

/* Mobile */
@media(max-width:767px){

.custom-contact-form{
    width:100%;
}

.custom-contact-form input[type="text"],
.custom-contact-form input[type="email"],
.custom-contact-form textarea,
.custom-contact-form input[type="submit"]{
    width:100%;
}



}

.custom-contact-form br {
    display: none !important;
}

@media (max-width: 767px) {

