-\"]').forEach(function (panel) {\r\n        panel.classList.add('show');\r\n    });\r\n\r\n    \/\/ Mark every accordion item as active\r\n    document.querySelectorAll('.accordion-item.panel').forEach(function (item) {\r\n        item.classList.add('active');\r\n    });\r\n\r\n    \/\/ Fix toggle links: set aria-expanded true, remove collapsed class, and detach from parent\r\n    \/\/ so clicking one doesn't force-close the others\r\n    document.querySelectorAll('[data-bs-toggle=\"collapse\"], [data-toggle=\"collapse\"]').forEach(function (link) {\r\n        link.setAttribute('aria-expanded', 'true');\r\n        link.classList.remove('collapsed');\r\n        link.removeAttribute('data-bs-parent');\r\n        link.removeAttribute('data-parent');\r\n    });\r\n\r\n    \/\/ Also strip data-bs-parent \/ data-parent off the collapse divs themselves\r\n    document.querySelectorAll('.accordion-collapse, [id^=\"collapse-\"]').forEach(function (panel) {\r\n        panel.removeAttribute('data-bs-parent');\r\n        panel.removeAttribute('data-parent');\r\n    });\r\n}\r\n\r\ndocument.addEventListener('DOMContentLoaded', openAllAccordions);\r\nwindow.addEventListener('load', openAllAccordions);\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-940328d elementor-widget__width-auto elementor-widget elementor-widget-html\" data-id=\"940328d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<div class=\"bsh-heading-social\" class=\"social\">\r\n    <span class=\"bsh-line\"><\/span>\r\n    <div class=\"bsh-text-col-social\">\r\n        <h2 class=\"bsh-title\">LETS SOCIALIZE <\/h2>\r\n        <div class=\"social-icons\">\r\n        <a href=\"https:\/\/www.instagram.com\/fierrojewellery\/\" target=\"_blank\"><img decoding=\"async\" src=\"https:\/\/soharon.co.uk\/dev-101\/wp-content\/uploads\/2026\/05\/Instagram-Icon.svg\" alt=\"Instagram\"><\/a>\r\n        <a href=\"https:\/\/www.facebook.com\