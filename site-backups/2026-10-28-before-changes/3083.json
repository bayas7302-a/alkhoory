"settings": {"title": "After you place an order you will receive an email confirming that we have received it. Your order is accepted when it is dispatched. We may decline or cancel an order, for example if a product is out of stock, the price is incorrect or we suspect fraud. If we cancel after you have paid, we will refund you in full.", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "386dbe6", "elType": "widget", "settings": {"title": "PAYMENT", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "typography_font_size_mobile": {"unit": "px", "size": 14, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "e9d6563", "elType": "widget", "settings": {"title": "We accept credit and debit cards (Visa, Mastercard, American Express) and, where available, Apple Pay, Google Pay and Link. Payments are processed securely by Stripe. You may also be offered instalment payments with Tabby, subject to Tabby's own terms and approval. We do not store your card details.", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "758709f", "elType": "widget", "settings": {"title": "SHIPPING & DELIVERY", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "typography_font_size_mobile": {"unit": "px", "size": 14, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "7bbf130", "elType": "widget", "settings": {"title": "<strong>UAE:</strong> orders placed before 1 PM are delivered the same day; orders after 1 PM are delivered the next working day. Orders placed on Saturday after 1 PM are delivered on Monday. There are no deliveries on weekends or public holidays. Delivery is free on orders above AED 150; a flat rate of AED 25 applies below that.<br><br><strong>International:</strong> delivery usually takes 3 to 7 working days. The shipping cost is calculated at checkout. Customs duties and import taxes are the responsibility of the recipient. We are not responsible for delays caused by customs or the courier. If a delivery is refused, the customer is responsible for the charges incurred, including return shipping.<br><br>More details: <a href=\"https://soharon.co.uk/dev-101/shipping-and-payments/\" style=\"color:#222222;text-decoration:underline;\">Shipping & Payments</a>.", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "9eda080", "elType": "widget", "settings": {"title": "CANCELLING OR CHANGING AN ORDER", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "typography_font_size_mobile": {"unit": "px", "size": 14, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "672259e", "elType": "widget", "settings": {"title": "You can cancel or change your order before it is dispatched by contacting us at <a href=\"mailto:support@fierrojewelry.com\" style=\"color:#222222;text-decoration:underline;\">support@fierrojewelry.com</a> or on WhatsApp at +971 52 779 4759. Once an order has been dispatched it can no longer be cancelled.", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "979f8cf", "elType": "widget", "settings": {"title": "RETURNS, EXCHANGES & REFUNDS", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "typography_font_size_mobile": {"unit": "px", "size": 14, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "7f9a027", "elType": "widget", "settings": {"title": "If you receive a faulty or incorrect item, contact us within 24 hours of delivery. Items can be returned in their original, unused condition with packaging and proof of purchase. Items bought on sale or with a discount, accidentally damaged items and earrings (for hygiene reasons) cannot be returned unless faulty. Returns and exchanges are available for UAE orders only, and shipping charges are not refundable. Approved refunds are made to the original payment method. Full details: <a href=\"https://soharon.co.uk/dev-101/returns-exchange/\" style=\"color:#222222;text-decoration:underline;\">Returns & Exchange</a>."