le h2{\r\n    margin:0;\r\n    font-family:\"Jost\", Sans-serif;\r\n    font-size:22px;\r\n    font-weight:300;\r\n    color:#222222;\r\n    line-height:1;\r\n}\r\n\r\n.custom-title span{\r\n    width:80px;\r\n    height:0.5px;\r\n    background:#6d6e71;\r\n    display:block;\r\n}\r\n\r\n/* Mobile Responsive */\r\n@media(max-width:767px){\r\n\r\n.custom-title{\r\n    gap:10px;\r\n}\r\n\r\n.custom-title h2{\r\n    font-size:14px;\r\n    text-align: center;\r\n}\r\n\r\n.custom-title span{\r\n    width:40px;\r\n    height:0.25px;\r\n}\r\n\r\n}\r\n</style>", "_element_width": "initial", "_element_custom_width": {"unit": "%", "size": 48, "sizes": []}, "_flex_align_self": "center", "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "40", "left": "0", "isLinked": false}, "_element_custom_width_mobile": {"unit": "%", "size": 80, "sizes": []}, "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}}, "elements": [], "widgetType": "html"}, {"id": "6575dcb", "elType": "widget", "settings": {"title": "Last updated: 27 October 2026<br><br>This website is operated by FIERRO (\"FIERRO\", \"we\", \"us\"), P.O. Box 125074, Dubai, United Arab Emirates. We respect your privacy. This policy explains what personal data we collect when you visit our website, create an account or place an order, how we use it and the choices you have. We handle personal data in line with the laws of the United Arab Emirates, including Federal Decree-Law No. 45 of 2021 on the Protection of Personal Data.", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "c240945", "elType": "widget", "settings": {"title": "INFORMATION WE COLLECT", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "typography_font_size_mobile": {"unit": "px", "size": 14, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "90cd083", "elType": "widget", "settings": {"title": "<strong>Information you give us:</strong> your name, email address, phone number, billing and delivery address, order notes, account login details, and anything you send us through our contact, distributor/retailer or newsletter forms.<br><br><strong>Order and payment information:</strong> the products you buy, order value, currency and delivery details. Card payments are processed securely by our payment provider (Stripe) and instalment payments by Tabby. We never see or store your full card number.<br><br><strong>Technical information:</strong> your IP address, device and browser type, the pages you visit, and your chosen currency and wishlist items, collected through cookies (see below).", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "96890c8", "elType": "widget", "settings": {"title": "HOW WE USE YOUR INFORMATION", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "typography_font_size_mobile": {"unit": "px", "size": 14, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "2806bd3", "elType": "widget", "settings": {"title": "We use your information to:<br>\u2022 process, deliver and support your orders, returns and exchanges<br>\u2022 take payment and prevent fraud<br>\u2022 manage your account and wishlist<br>\u2022 answer your questions and requests<br>\u2022 send you our newsletter and offers, only if you have subscribed (you can unsubscribe at any time)<br>\u2022 keep our website secure and improve it<br>\u2022 meet our legal, accounting and tax obligations", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "1a71d7e", "elType": "widget", "settings": {"title": "WHO WE SHARE IT WITH", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "typography_font_size_mobile": {"unit": "px", "size": 14, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "a0cea2d", "elType": "widget", "settings": {"title": "We only share your information where needed to run our business:<br>\u2022 <strong>Payment providers</strong> (Stripe, and Tabby if you choose to pay in instalments) to process payments<br>\u2022 <strong>Delivery partners and couriers</strong> to deliver your order<br>\u2022 <strong>Website, hosting and email service providers</strong> who help us run this website<br>\u2022 <strong>Authorities</strong> when required by law<br><br>We do not sell or rent your personal data. Some of these providers may process data outside the UAE; where this happens we rely on them to protect it to an appropriate standard.", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "f6d7618", "elType": "widget", "settings": {"title": "HOW LONG WE KEEP IT", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "typography_font_size_mobile": {"unit": "px", "size": 14, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "8572d58", "elType": "widget", "settings": {"title": "We keep order and invoice records for as long as UAE law requires (generally at least five years for tax records). Account information is kept while your account is active. Newsletter data is kept until you unsubscribe. Other information is deleted when it is no longer needed.", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "9b8fc9f", "elType": "widget", "settings": {"title": "KEEPING YOUR DATA SAFE", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "typography_font_size_mobile": {"unit": "px", "size": 14, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "856e983", "elType": "widget", "settings": {"title": "Our website uses secure (HTTPS) connections, payments are handled by PCI-DSS compliant providers, and access to personal data is limited to people who need it. No method of transmission over the internet is completely secure, but we take reasonable steps to protect your information.", "header_size": "p", "align": "justify", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_font_weight": "300", "typography_line_height": {"unit": "em", "size": 1.4, "sizes": []}, "title_color": "#6D6E71", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "35", "left": "0", "isLinked": false}, "lqd_parallax_settings_trigger_start": "top bottom", "lqd_parallax_settings_trigger_end": "bottom top", "_margin_mobile": {"unit": "px", "top": "0", "right": "0", "bottom": "30", "left": "0", "isLinked": false}, "typography_font_size_mobile": {"unit": "px", "size": 12, "sizes": []}}, "elements": [], "widgetType": "heading"}, {"id": "edb9df6", "elType": "widget", "settings": {"title": "YOUR RIGHTS", "typography_typography": "custom", "typography_font_family": "Jost", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_font_weight": "300", "title_color": "#222222", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "20", "lef